data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
*.log
logs/

# ---------------------------------------------------------------- Model weights
# Exported by models/export_int8.py; too large for git
models/*.onnx
models/*.pt
models/*.engine

# ---------------------------------------------------------------- Secrets / local config
.env
.env.*
!.env.example

# ---------------------------------------------------------------- Editors / OS
